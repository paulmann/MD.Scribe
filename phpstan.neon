parameters:
    level: 6
    paths:
        - src
        - public/index.php
        - public/admin.php
        - md.php
        - index.php
        - updater.php
        # bin/md-scribe-render is a user-facing CLI entry point, analysed by hand
        # (php -l + a smoke run). The exclusion and its price are documented in
        # docs/development.md, "Code outside static analysis".
    excludePaths:
        # Generated files — huge static maps, no logic.
        - src/View/Icons.php
        - src/Markdown/EmojiMap.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        #
        # Deliberate runtime guard: PHPStan analyzes ON one PHP version so the
        # check looks "always false" — it exists for other 8.5 patch releases
        # than the one the analyser runs on.
        -
            message: '#Comparison operation "<" between int<80500, 80699> and 80500 is always false\.#'
            path: src/bootstrap.php
        #
        # Templates mutate $this->layout through extend() during renderFile();
        # PHPStan cannot see the indirect write.
        -
            message: '#Strict comparison using !== between null and null will always evaluate to false\.#'
            path: src/View/Template.php
        #
        # TECH DEBT RATCHET: array value types are being tightened module by
        # module. Do not add new entries here — annotate new code instead.
        -
            identifier: missingType.iterableValue
