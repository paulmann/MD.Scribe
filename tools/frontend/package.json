{
  "name": "mdviewer-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Local asset pipeline for MD.Viewer — Tailwind CSS v4 build, vendored Mermaid/KaTeX/fonts/icons. No CDN at runtime.",
  "scripts": {
    "build": "node build.mjs",
    "css": "tailwindcss -i src/css/app.css -o ../../public/assets/css/app.css --minify",
    "css:dev": "tailwindcss -i src/css/app.css -o ../../public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "mermaid": "^11.6.0",
    "katex": "^0.16.22",
    "lucide-static": "^0.469.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5"
  }
}
