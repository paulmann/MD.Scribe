{
    "name": "mdviewer/md-viewer",
    "description": "MD.Viewer — secure, self-hosted Markdown documentation viewer and browser with a full admin panel. PHP 8.3, Tailwind CSS, shadcn/ui-style design system, zero CDN dependencies.",
    "type": "project",
    "license": "MIT",
    "keywords": ["markdown", "viewer", "documentation", "php", "tailwind", "shadcn"],
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "league/commonmark": "^2.7",
        "scrivo/highlight.php": "^9.18"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": { "MdViewer\\": "src/" },
        "files": []
    },
    "autoload-dev": {
        "psr-4": { "MdViewer\\Tests\\": "tests/" }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": true
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse --memory-limit=1G",
        "check": ["@stan", "@test"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
